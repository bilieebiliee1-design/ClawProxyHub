    <!-- ===== 引导 Step3：使用指南 ===== -->
    <string name="onboard_title_guide">快速上手</string>
    <!-- v1.3.0 ⑤：与官方源 index 全量内置 10 个 Go 插件的现状对齐（原「安卓端仅可
         安装 Lua 插件」旧文案清除） -->
    <string name="guide_plugins_title">认识插件</string>
    <string name="guide_plugins_text">打开管理面板 → 插件 → 市场。官方源 index 的 10 个 Go 插件已全部随 APK 内置，核心启动即自动加载，无需安装；Lua 插件可经 市场 / 自建源 / 离线上传 在线安装。</string>
    <string name="guide_tunnel_title">临时隧道默认关闭</string>
    <string name="guide_tunnel_text">隧道会把网关 API 暴露到公网临时域名，cph-* 密钥是唯一防线。确需远程调用时在主界面开启，用完即断。</string>
    <string name="guide_bg_title">保持后台运行</string>
    <string name="guide_bg_text">任务调度与常驻网关由前台服务承载；建议在系统中关闭本应用的电池优化，接受 Doze 下定时任务可能漂移。配合悬浮窗保活可在任意界面查看网关状态。</string>
    <string name="guide_battery">去关电池优化</string>


    <!-- ===== 使用说明（8 节分步文案：每步一行主文 + 一行辅助文，不配图） ===== -->
    <string name="guide_s1_title">第 1 节 · 第一次使用</string>
    <string-array name="guide_s1_steps">
        <item>首次启动请先阅读并同意使用协议与免责声明</item>
        <item>创建管理员账号：用户名 + 至少 10 位、含大小写与数字的密码</item>
        <item>核心启动依次完成：初始化数据库 → SQL 迁移 → 插件目录 → 面板就绪</item>
        <item>完成后进入首页，核心已自动运行</item>
    </string-array>
    <string-array name="guide_s1_subs">
        <item>拒绝将无法进入应用</item>
        <item>该账号仅用于登录本机管理面板</item>
        <item>首次启动通常几秒内完成</item>
        <item>外观与语言可随时在「设置」调整</item>
    </string-array>
    <string name="guide_s2_title">第 2 节 · 打开面板</string>
    <string-array name="guide_s2_steps">
        <item>点击底部「面板」页签</item>
        <item>使用引导中创建的管理员账号登录</item>
    </string-array>
    <string-array name="guide_s2_subs">
        <item>面板为本机 WebView 内嵌页面，仅监听 127.0.0.1</item>
        <item>已保存凭据时会自动登录</item>
    </string-array>
    <string name="guide_s3_title">第 3 节 · 插件与市场</string>
    <string-array name="guide_s3_steps">
        <item>打开面板 → 插件 → 市场</item>
        <item>三种入口：市场 / 自建源 / 离线上传</item>
    </string-array>
    <string-array name="guide_s3_subs">
        <item>官方源 index 全量 10 个 Go 插件已随 APK 内置，开箱即用</item>
        <item>Lua 插件可在安卓端在线安装；Go 插件无法在线安装，随 APK 更新</item>
    </string-array>
    <string name="guide_s4_title">第 4 节 · 配置上游与密钥</string>
    <string-array name="guide_s4_steps">
        <item>在面板内新建账号并创建 cph-* 对外密钥</item>
        <item>客户端填入 127.0.0.1:&lt;网关端口&gt; 与密钥</item>
    </string-array>
    <string-array name="guide_s4_subs">
        <item>密钥是隧道开启后的唯一防线</item>
        <item>网关地址可在首页状态卡一键复制</item>
    </string-array>
    <string name="guide_s5_title">第 5 节 · 远程访问·临时隧道</string>
    <string-array name="guide_s5_steps">
        <item>「临时隧道」默认关闭（设置 → 隧道）</item>
        <item>确认风险后开启，用完即断</item>
        <item>局域网监听默认开启：仅 /v1+密钥与 /health，面板可关</item>
        <item>失败时在卡片查看错误与重试</item>
    </string-array>
    <string-array name="guide_s5_subs">
        <item>开启会把网关 API 暴露到公网临时域名</item>
        <item>局域网侧仅 /v1（强制密钥）与 /health，面板可关</item>
        <item>cph-* 密钥是唯一防线</item>
        <item>排查详情见「设置 → 诊断 → 运行日志」</item>
    </string-array>
    <string name="guide_s6_title">第 6 节 · 后台常驻</string>
    <string-array name="guide_s6_steps">
        <item>前台服务在「设置 → 保活与权限」开启</item>
        <item>建议关闭本应用的电池优化</item>
    </string-array>
    <string-array name="guide_s6_subs">
        <item>建议保持开启以保证后台稳定</item>
        <item>Doze 下定时任务可能漂移</item>
    </string-array>
    <string name="guide_s7_title">第 7 节 · 备份与恢复</string>
    <string-array name="guide_s7_steps">
        <item>面板 → 设置 → 导出备份 zip</item>
        <item>恢复：导入 zip 后按提示重启核心</item>
    </string-array>
    <string-array name="guide_s7_subs">
        <item>备份含数据库与密钥，请妥善保存</item>
        <item>恢复会替换当前全部数据</item>
    </string-array>
    <string name="guide_s8_title">第 8 节 · 常见问题</string>
    <string-array name="guide_s8_steps">
        <item>面板打不开？确认核心已运行</item>
        <item>隧道连不上？查看运行日志</item>
        <item>通知不显示？检查系统通知权限</item>
        <item>如何改管理员密码？设置 → 安全</item>
    </string-array>
    <string-array name="guide_s8_subs">
        <item>核心未运行时面板页签显示启动按钮</item>
        <item>边缘节点解析失败或运营商拦截 UDP 时会自动改用 HTTP/2</item>
        <item>设置 → 保活与权限 → 去系统设置</item>
        <item>面板内修改仅受 6 位下限，建议同步本机 10 位规则</item>
    </string-array>

